
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\tModLoader.targets" />
  <PropertyGroup>
    <AssemblyName>JourneyModeFullResearch</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <Features>strict</Features>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-strict</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Localization\en-US.hjson" />
    <None Remove="Localization\en-US_Mods.JourneyModeFullResearch.Configs.hjson" />
    <None Remove="Localization\ru-RU.hjson" />
    <None Remove="Localization\ru-RU_Mods.JourneyModeFullResearch.Configs.hjson" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>